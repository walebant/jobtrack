# Copy to .env.local and fill in. Never commit .env.local.

# Supabase dashboard > Project Settings > API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key, or the newer "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by tests and Phase 2 jobs, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase dashboard > Connect > ORMs (Drizzle) > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Optional. The public URL used in magic links. Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Server only. Not used until milestone 2.
ANTHROPIC_API_KEY=
